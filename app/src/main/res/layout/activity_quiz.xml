<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quizMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    tools:context=".QuizActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Left: ✕ Keluar Button -->
            <LinearLayout
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Keluar"
                    android:src="@drawable/ic_close"
                    app:tint="#CBD5E1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Keluar"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top Center: SET Title in Gold -->
            <TextView
                android:id="@+id/tvSetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="SET 1 — CORE CONCEPTS"
                android:textColor="@color/gold_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <!-- Top Right: Score / Progress counter (0/13) -->
            <TextView
                android:id="@+id/tvScoreCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="0/13"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Question Counter Row -->
        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Soalan 1 daripada 13"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Gold Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/pb_gold_style" />
    </LinearLayout>

    <!-- Question Content ScrollArea -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Chapter Badge -->
                    <TextView
                        android:id="@+id/tvChapter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Bab 1: Warisan Negara Bangsa"
                        android:textColor="@color/gold_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Question Text -->
                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Apakah ciri utama pembentukan kerajaan Kesultanan Melayu Melaka?"
                        android:textColor="@color/text_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                    <!-- Option A -->
                    <LinearLayout
                        android:id="@+id/layoutOptionA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelA"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionA"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Pilihan A"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Option B -->
                    <LinearLayout
                        android:id="@+id/layoutOptionB"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelB"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Pilihan B"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Option C -->
                    <LinearLayout
                        android:id="@+id/layoutOptionC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelC"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Pilihan C"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Option D -->
                    <LinearLayout
                        android:id="@+id/layoutOptionD"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelD"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="D"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionD"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Pilihan D"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Explanation Card (Penerangan - can be toggled/shown) -->
                    <LinearLayout
                        android:id="@+id/layoutExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@color/card_info_bg"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Penerangan Jawapan:"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExplanationText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Penerangan terperinci mengenai soalan ini."
                            android:textColor="@color/text_body"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Buttons -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnExplanation"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Penerangan"
            android:textColor="@color/navy_header"
            android:textSize="13sp"
            app:strokeColor="@color/navy_header" />

        <Button
            android:id="@+id/btnPrev"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Sebelum"
            android:textColor="@color/text_body"
            android:textSize="13sp"
            app:strokeColor="@color/option_default_stroke" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:background="@drawable/btn_gold"
            app:backgroundTint="@null"
            android:text="Seterusnya"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>