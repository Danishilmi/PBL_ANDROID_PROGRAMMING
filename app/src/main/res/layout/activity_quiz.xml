<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quizMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    tools:context=".QuizActivity">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_header"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Left: ✕ Exit Button -->
            <ImageView
                android:id="@+id/btnExit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Keluar"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="#CBD5E1" />

            <!-- Top Right: Answered counter (0/10) -->
            <TextView
                android:id="@+id/tvScoreCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="0/10"
                android:textColor="#CBD5E1"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Question Counter Row -->
        <TextView
            android:id="@+id/tvProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Soalan 1 daripada 13"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Gold Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/pb_gold_style" />
    </LinearLayout>

    <!-- Question Content ScrollArea -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Chapter Badge -->
                    <TextView
                        android:id="@+id/tvChapter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="Bab 1: Warisan Negara Bangsa"
                        android:textColor="@color/gold_dark"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Question Diagram (shown only when the question has an image) -->
                    <ImageView
                        android:id="@+id/ivQuestionImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:maxHeight="200dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Rajah soalan"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <!-- Question Text -->
                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Kenyataan soalan Betul atau Salah."
                        android:textColor="@color/text_title"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp" />

                    <!-- Option: Betul -->
                    <LinearLayout
                        android:id="@+id/layoutOptionTrue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelTrue"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionTrue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Betul"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Option: Salah -->
                    <LinearLayout
                        android:id="@+id/layoutOptionFalse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_option_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvLabelFalse"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center"
                            android:text="S"
                            android:textColor="@color/navy_header"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOptionFalse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Salah"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Buttons -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnPrev"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Sebelum"
            android:textColor="@color/text_body"
            android:textSize="13sp"
            app:strokeColor="@color/option_default_stroke" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:background="@drawable/btn_gold"
            app:backgroundTint="@null"
            android:text="Seterusnya"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>